# Used when running the API outside Docker (go run ./cmd/server).
# docker compose sets these itself.
HTTP_ADDR=:8080
DATABASE_URL=postgres://payments:payments@localhost:5432/payments?sslmode=disable

# 32 bytes in base64. Generate one with: openssl rand -base64 32
CARD_ENCRYPTION_KEY=

# Maximum amount per payment, in minor units (CLP has no decimals; USD in cents).
MAX_AMOUNT_CLP=5000000
MAX_AMOUNT_USD=500000

# The acquirer (the mock in docker compose) and how long to wait for it.
ACQUIRER_URL=http://localhost:8081
ACQUIRER_TIMEOUT=5s

# Goroutines that process payments in the background.
WORKER_CONCURRENCY=4
