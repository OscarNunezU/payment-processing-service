# Only the Next.js server reaches the API, with the demo merchant's secret
# key: the browser never holds it.
API_URL=http://localhost:8080
MERCHANT_API_KEY=sk_test_local_tienda_uno
# The checkout embeds the acquirer's card fields from its public port, with
# the publishable key; the server reaches its admin port for the faults.
ACQUIRER_PUBLIC_URL=http://localhost:8090
ACQUIRER_PUBLISHABLE_KEY=pk_sim_local_only
ACQUIRER_ADMIN_URL=http://localhost:8091
# The secrets that sign each local merchant's webhooks: <merchant id>=<secret>.
WEBHOOK_SECRETS=00000000-0000-4000-8000-000000000001=whsec_local_only_tienda_uno,00000000-0000-4000-8000-000000000002=whsec_local_only_tienda_dos,00000000-0000-4000-8000-000000000003=whsec_local_only_suspendida
